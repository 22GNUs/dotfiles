{
  "lastChangelogVersion": "0.82.1",
  "theme": "cyber-ui-dark",
  "externalEditor": "nvim",
  "packages": [
    "npm:pi-web-access",
    "npm:@eko24ive/pi-ask",
    "npm:@juicesharp/rpiv-todo",
    "npm:@mohndoe/pi-atlas",
    "npm:pi-cyber-ui",
    "npm:@narumitw/pi-caffeinate",
    "npm:@ff-labs/pi-fff",
    "git:github.com/jonjonrankin/pi-caveman",
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:pi-schedule-prompt",
    "npm:pi-hashline-edit-pro",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "git:github.com/router-for-me/pi-cliproxyapi-provider",
      "extensions": ["-extensions/tps.ts"]
    }
  ],
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": false
  },
  "images": {
    "blockImages": false
  },
  "quietStartup": false,
  "compaction": {
    "enabled": true
  },
  "transport": "websocket-cached",
  "rewind": {
    "silentCheckpoints": false,
    "retention": {
      "maxSnapshots": 100,
      "maxAgeDays": 1,
      "scanMode": "ancestor-only",
      "pinLabeledEntries": true,
      "startupBudgetMs": 100
    }
  },
  "defaultProjectTrust": "always"
}
